{
  "name": "general-booking engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "engine-booking",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Booking Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "general-booking-engine"
    },
    {
      "parameters": {
        "jsCode": "// The webhook wraps the posted JSON under 'body'\nconst data = $json.body || $json;\n\nconst event = data.event_type;\nconst biz = data.business_name || 'Our Business';\nconst name = data.customer_name;\nconst phone = data.customer_phone;\nconst time = data.appointment_time;\nconst ownerEmail = data.owner_email;\n\n// Each Meta-approved template has its own variable order/count\nconst templates = {\n  booking_confirmed: { name: 'apptbook_confirmed', params: [name, biz, time] },\n  appointment_reminder: { name: 'apptbook_reminder', params: [name, biz, time] },\n  booking_completed: { name: 'apptbook_completed', params: [name, biz] },\n  booking_cancelled: { name: 'apptbook_cancelled', params: [name, biz, time] },\n  cancellation_requested: { name: 'apptbook_cancel_request', params: [name, time] },\n  cancellation_rejected: { name: 'apptbook_cancel_declined', params: [name, biz, time] }\n};\n\nconst ownerSubjects = {\n  booking_confirmed: `New booking confirmed - ${name}`,\n  appointment_reminder: `Reminder due - ${name}`,\n  booking_completed: `Booking completed - ${name}`,\n  booking_cancelled: `Booking cancelled - ${name}`,\n  cancellation_requested: `ACTION NEEDED: ${name} wants to cancel - approve or reject in the dashboard`,\n  cancellation_rejected: `Cancellation rejected - ${name} stays booked`\n};\n\nconst tpl = templates[event] || templates.booking_confirmed;\n\nreturn [{\n  json: {\n    customer_phone: phone,\n    owner_email: ownerEmail,\n    whatsapp_template: tpl.name,\n    whatsapp_params: tpl.params,\n    owner_subject: ownerSubjects[event] || `Booking update - ${name}`,\n    owner_body: `Event: ${event}\\nCustomer: ${name}\\nPhone: ${phone}\\nAppointment: ${time}`\n  }\n}];"
      },
      "id": "build-messages",
      "name": "Build Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "params-count-check",
              "leftValue": "={{ $json.whatsapp_params.length }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "param-count-if",
      "name": "If",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "sendTemplate",
        "phoneNumberId": "1386787104521744",
        "recipientPhoneNumber": "={{ $json.customer_phone }}",
        "template": "={{ $json.whatsapp_template }}|en",
        "components": {
          "component": [
            {
              "type": "body",
              "parameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.whatsapp_params[0] }}" },
                  { "type": "text", "text": "={{ $json.whatsapp_params[1] }}" },
                  { "type": "text", "text": "={{ $json.whatsapp_params[2] }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "whatsapp-send-3param",
      "name": "Send template1",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [900, 180],
      "credentials": {
        "whatsAppApi": {
          "id": "",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendTemplate",
        "phoneNumberId": "1386787104521744",
        "recipientPhoneNumber": "={{ $json.customer_phone }}",
        "template": "={{ $json.whatsapp_template }}|en",
        "components": {
          "component": [
            {
              "type": "body",
              "parameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.whatsapp_params[0] }}" },
                  { "type": "text", "text": "={{ $json.whatsapp_params[1] }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "whatsapp-send-2param",
      "name": "Send template2",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [900, 420],
      "credentials": {
        "whatsAppApi": {
          "id": "",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.owner_email }}",
        "subject": "={{ $json.owner_subject }}",
        "message": "={{ $json.owner_body }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Email Owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, 600],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Booking Webhook": {
      "main": [
        [
          { "node": "Build Messages", "type": "main", "index": 0 }
        ]
      ]
    },
    "Build Messages": {
      "main": [
        [
          { "node": "If", "type": "main", "index": 0 },
          { "node": "Email Owner", "type": "main", "index": 0 }
        ]
      ]
    },
    "If": {
      "main": [
        [
          { "node": "Send template1", "type": "main", "index": 0 }
        ],
        [
          { "node": "Send template2", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
